# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/enterprise_db
DATABASE_REPLICA_URL=postgresql://user:password@localhost:5432/enterprise_db
DB_USER=postgres
DB_PASSWORD=your_strong_db_password
DB_NAME=enterprise_db

# Redis - Single Node
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD is REQUIRED in production (NODE_ENV=production)
REDIS_PASSWORD=your_strong_redis_password

# Redis - Cluster Mode (comma-separated host:port pairs, overrides single node if set)
REDIS_CLUSTER_NODES=

# Cache TTL in seconds (default: 300 = 5 minutes)
CACHE_TTL_SECONDS=300

# Authentication & JWT Secrets (MUST be at least 32 characters in production)
JWT_ACCESS_SECRET=your-32-character-minimum-access-secret-here
JWT_REFRESH_SECRET=your-32-character-minimum-refresh-secret-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=https://yourdomain.com,https://pos.yourdomain.com

# Seed Admin Credentials
# If SEED_ADMIN_PASSWORD is not set:
#   - development: falls back to a dev-only default password
#   - production (NODE_ENV=production): generates a strong random password printed once
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

PORT=3000
NODE_ENV=development
