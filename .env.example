DATABASE_URL=postgresql://user:password@localhost:5432/enterprise_db
DATABASE_REPLICA_URL=postgresql://user:password@localhost:5432/enterprise_db

# Redis - single node
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Redis - cluster mode (comma-separated host:port pairs, overrides single node if set)
REDIS_CLUSTER_NODES=

# Cache TTL in seconds (default: 300 = 5 minutes)
CACHE_TTL_SECONDS=300

JWT_ACCESS_SECRET=your-access-secret
JWT_REFRESH_SECRET=your-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed admin credentials.
# If SEED_ADMIN_PASSWORD is not set:
#   - development: falls back to a dev-only default password
#   - production (NODE_ENV=production): generates a strong random password printed once
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
PORT=3000
NODE_ENV=development
